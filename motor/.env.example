# motor/.env — lo genera /instalar. NUNCA lo subas a GitHub (ya está en .gitignore).

# Usuario robot del motor (Firebase Authentication → correo/contraseña)
AGENT_EMAIL=tu-correo+agentes@gmail.com
AGENT_PASSWORD=PEGA_AQUI_LA_CONTRASENA

# Firebase (los mismos valores públicos de app/.env)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Fotos y videos gratis con licencia para uso comercial (opcional). Basta con una de las dos claves.
# Pixabay: crea una cuenta gratis y copia tu clave en https://pixabay.com/api/docs/ (sección "Parameters", campo key).
PIXABAY_API_KEY=
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=

# Telegram (opcional): bot creado con @BotFather y tu ID de usuario
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
